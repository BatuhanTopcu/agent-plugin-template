{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.mjs\" cursor session"
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.mjs\" cursor before"
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.mjs\" cursor after"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.mjs\" cursor failure"
      }
    ]
  }
}
